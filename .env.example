# Public client configuration only. Never place a wallet secret or a private RPC key
# in a NEXT_PUBLIC_ variable — it is shipped to every browser.

# Which networks appear in the network switcher, and which one opens by default.
NEXT_PUBLIC_ENABLED_CLUSTERS=mainnet-beta,devnet,testnet
NEXT_PUBLIC_DEFAULT_CLUSTER=devnet

# Browser RPC endpoints (reads + submitting signed transactions). The public
# endpoints are heavily rate-limited; use a dedicated provider for mainnet and
# restrict its key to your domain. Keep the cluster name in devnet/testnet URLs
# so wallets detect the right chain.
NEXT_PUBLIC_RPC_URL_MAINNET=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_RPC_URL_DEVNET=https://api.devnet.solana.com
NEXT_PUBLIC_RPC_URL_TESTNET=https://api.testnet.solana.com

# Ringio program ID per network. Leave as-is if you deploy with the same program
# keypair everywhere; the UI detects when the program is not deployed yet.
NEXT_PUBLIC_PROGRAM_ID_MAINNET=JBhfRyHLDdTyGKz78hzeA26kKmtwd37PFkX3tvwmbmYy
NEXT_PUBLIC_PROGRAM_ID_DEVNET=JBhfRyHLDdTyGKz78hzeA26kKmtwd37PFkX3tvwmbmYy
NEXT_PUBLIC_PROGRAM_ID_TESTNET=JBhfRyHLDdTyGKz78hzeA26kKmtwd37PFkX3tvwmbmYy

# Settlement asset per network (6-decimal Circle USDC by default).
NEXT_PUBLIC_USDC_MINT_MAINNET=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
NEXT_PUBLIC_USDC_MINT_DEVNET=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Solana testnet has no Circle USDC. Create a classic SPL test token and put its
# mint here (see docs/mainnet-deployment.md); leave empty to let creators paste one.
NEXT_PUBLIC_USDC_MINT_TESTNET=

# Server-only RPC overrides for /api routes (may contain private API keys).
SOLANA_RPC_URL_MAINNET=
SOLANA_RPC_URL_DEVNET=
SOLANA_RPC_URL_TESTNET=

# Server-only AI matching. Never prefix the API key with NEXT_PUBLIC_.
# Leave OPENROUTER_API_KEY empty to use the deterministic local matcher.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_TIMEOUT_MS=8000

# Set true only if the selected OpenRouter model/provider has a compatible
# Zero Data Retention endpoint. Public group metadata is sent; private member
# data, wallet addresses, invite secrets, and contact details are rejected.
OPENROUTER_ZDR=false

# Leave false unless the deployment is behind a proxy you control. Vercel's
# verified forwarding header is handled automatically when VERCEL=1.
RINGIO_TRUST_PROXY_IP_HEADERS=false
